# Backend base URL the mobile app talks to.
#
# The mobile app runs inside a device/emulator, not on the same machine as
# the backend, so "localhost" almost never means the right thing here:
#   - Android emulator -> host machine's localhost is reached via 10.0.2.2
#   - Physical Android device on the same Wi-Fi -> use the dev machine's LAN IP,
#     e.g. http://192.168.1.23:8000
#   - Production -> the real deployed backend URL
#
# This is read at BUILD time (Vite inlines it into the bundle), so change it
# and re-run `npm run build && npx cap sync android` to take effect on-device.
VITE_API_BASE_URL=http://10.0.2.2:8000
