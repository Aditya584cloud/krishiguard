# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/krishiguard"

PORT=8000
NODE_ENV=development

# data.gov.in API key for the mandi (market price) resource.
# Get one at https://data.gov.in/user/register — required for the /api/market
# endpoint and for the market signal used by /api/distress. Without it, both
# endpoints respond with an honest 503 rather than fabricated market data.
DATA_GOV_API_KEY=
